import os

while True:
    print("\n--- NOTAS DA TURMA ---")
    print("[1] Cadastrar aluno")
    print("[2] Calcular médias")
    print("[3] Fazer exame")
    print("[4] Ver resultados")
    print("[0] Sair")
    escolha = input("> ")

    if escolha == "0":
        print("Encerrando...")
        break

    if escolha == "1":
        nome = input("Nome: ")
        notas = []

        for i in range(3):
            n = float(input(f"Nota {i + 1}: ").replace(",", "."))
            while n < 0 or n > 10:
                print("A nota deve ser de 0 a 10.")
                n = float(input(f"Nota {i + 1}: ").replace(",", "."))
            notas.append(n)

        with open("notas.txt", "a", encoding="utf-8") as f:
            f.write(f"{nome};{notas[0]};{notas[1]};{notas[2]}\n")
        print("Aluno salvo!")

    elif escolha == "2":
        if not os.path.exists("notas.txt"):
            print("Cadastre alunos primeiro.")
            continue

        with open("notas.txt", "r", encoding="utf-8") as f:
            linhas = f.readlines()

        if len(linhas) == 0:
            print("Cadastre alunos primeiro.")
            continue

        with open("aprovados.txt", "w", encoding="utf-8") as ap, \
             open("exame.txt", "w", encoding="utf-8") as ex, \
             open("reprovados.txt", "w", encoding="utf-8") as rep:

            for i in range(len(linhas)):
                dados = linhas[i].strip().split(";")
                media = (float(dados[1]) + float(dados[2]) + float(dados[3])) / 3
                mf = round(media, 2)

                if media >= 7:
                    ap.write(f"{dados[0]};{mf};Aprovado\n")
                    print(f"{dados[0]}: {mf} -> Aprovado")
                elif media >= 5:
                    ex.write(f"{dados[0]};{mf}\n")
                    print(f"{dados[0]}: {mf} -> Exame")
                else:
                    rep.write(f"{dados[0]};{mf};Reprovado\n")
                    print(f"{dados[0]}: {mf} -> Reprovado")

        print("Arquivos gerados!")

    elif escolha == "3":
        if not os.path.exists("exame.txt"):
            print("Nenhum aluno em exame.")
            continue

        with open("exame.txt", "r", encoding="utf-8") as f:
            linhas = f.readlines()

        if len(linhas) == 0:
            print("Nenhum aluno em exame.")
            continue

        with open("aprovados.txt", "a", encoding="utf-8") as ap, \
             open("reprovados.txt", "a", encoding="utf-8") as rep:

            for i in range(len(linhas)):
                dados = linhas[i].strip().split(";")
                media_ant = float(dados[1])

                print(f"\n{dados[0]} (média {media_ant})")
                prova = float(input("Nota do exame: ").replace(",", "."))
                while prova < 0 or prova > 10:
                    print("A nota deve ser de 0 a 10.")
                    prova = float(input("Nota do exame: ").replace(",", "."))

                nova = (media_ant + prova) / 2
                nf = round(nova, 2)

                if nova >= 5:
                    ap.write(f"{dados[0]};{nf};Aprovado após exame\n")
                    print(f"Média final {nf} -> Aprovado após exame")
                else:
                    rep.write(f"{dados[0]};{nf};Reprovado após exame\n")
                    print(f"Média final {nf} -> Reprovado após exame")

        open("exame.txt", "w", encoding="utf-8").close()

    elif escolha == "4":
        print("\n--- RESULTADOS ---")
        achou = False

        for nome_arq in ["aprovados.txt", "reprovados.txt"]:
            if os.path.exists(nome_arq):
                with open(nome_arq, "r", encoding="utf-8") as f:
                    linhas = f.readlines()

                for i in range(len(linhas)):
                    dados = linhas[i].strip().split(";")
                    print(f"{dados[0]} - Média: {dados[1]} - {dados[2]}")
                    achou = True

        if not achou:
            print("Nenhum resultado ainda.")

    else:
        print("Opção inválida!")
